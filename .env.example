MLX_BASE_URL=http://YOUR_MAC_IP:8080
MLX_MODEL=mlx-community/Qwen3-8B-4bit
TAVILY_API_KEY=your_tavily_api_key_here

# EXCON — dry-run is on by default so sends never hit a network
EXCON_DRY_RUN=true

# Outreach email OTP. Off until SMTP can deliver a real code.
OTP_REQUIRED=false

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Slack
SLACK_BOT_TOKEN=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# LinkedIn official partner API (unused in this phase)
LINKEDIN_ACCESS_TOKEN=